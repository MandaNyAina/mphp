# Shared hosting where you cannot change the document root:
# everything is served from public/, nothing else is reachable.
# (If your web root already points at public/, this file is not used.)
Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
