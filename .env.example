APP_NAME=M-PHP
APP_ENV=local
APP_DEBUG=true

# Generate with: php bin/mphp key:generate
APP_KEY=

# Only behind a trusted reverse proxy
TRUST_PROXY=false

# sqlite (default, zero setup) | mysql | pgsql
DB_CONNECTION=sqlite
DB_PATH=storage/database.sqlite

# Used by mysql / pgsql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mphp
DB_USERNAME=root
DB_PASSWORD=
